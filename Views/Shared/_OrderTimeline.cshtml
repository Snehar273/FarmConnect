@model Order
@{
  var o = Model; var lg = o.Logistics;
  var ended = o.Status == OrderStatus.Rejected || o.Status == OrderStatus.Cancelled;
  var st = new string[4]; var sub = new string[4];
  var ic = new[] { "📝", "🚚", "✅", "🎉" };
  var nm = new[] { "Order placed", "Transport", "Farmer accepted", "Completed" };
  st[0] = "done"; sub[0] = o.CreatedAt.ToString("dd MMM, HH:mm");
  if (lg == null) { st[1] = ended ? "wait" : "load"; sub[1] = ended ? "No booking" : "Arranging…"; }
  else if (lg.BookingStatus == BookingStatus.Cancelled) { st[1] = "bad"; sub[1] = "Booking cancelled"; ic[1] = "🚫"; }
  else if (lg.BookingStatus == BookingStatus.PendingAssignment) { st[1] = "warn"; sub[1] = "Awaiting partner"; }
  else { st[1] = "done"; sub[1] = lg.Partner != null ? lg.Partner.PartnerName : lg.BookingStatus.ToString(); }
  if (o.Status == OrderStatus.Accepted || o.Status == OrderStatus.Completed) { st[2] = "done"; sub[2] = "Order confirmed"; }
  else if (ended) { st[2] = "bad"; nm[2] = o.Status == OrderStatus.Rejected ? "Rejected" : "Cancelled"; ic[2] = o.Status == OrderStatus.Rejected ? "❌" : "🚫"; sub[2] = "Stock released"; }
  else { st[2] = "wait"; sub[2] = "Awaiting farmer"; }
  if (o.Status == OrderStatus.Completed) { st[3] = "done"; sub[3] = o.CompletedAt.HasValue ? o.CompletedAt.Value.ToString("dd MMM, HH:mm") : "Done"; }
  else { st[3] = "wait"; sub[3] = ended ? "—" : "Pending"; }
  var now = -1; var far = 0;
  for (var a = 0; a < 4; a++) { if (st[a] != "done" && now < 0) now = a; }
  for (var b = 0; b < 4; b++) { if (st[b] == "done") far = b; }
  if (ended) now = 2;
}
<div class="otlw" style="--p:@(far * 100 / 3)%">
  <div class="otl-track" aria-hidden="true"><i></i><b></b></div>
  <ol class="otl" aria-label="Order @o.OrderNo: @o.Status">
    @for (var k = 0; k < 4; k++)
    {
      <li class="nd @st[k] @(k == now ? "now" : "")" style="--k:@k" @(k == now ? Html.Raw("aria-current=\"step\"") : null)>
        <div class="dot">@if (st[k] == "load") { <span class="spin"></span> } else { <span>@ic[k]</span> }</div>
        <b>@nm[k]</b><small>@sub[k]</small>
      </li>
    }
  </ol>
</div>