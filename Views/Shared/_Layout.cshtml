@inject UserManager<ApplicationUser> UM
@{
  var auth = User.Identity.IsAuthenticated;
  var who = auth ? (await UM.GetUserAsync(User))?.FullName : null;
  var first = string.IsNullOrWhiteSpace(who) ? "friend" : who.Split(' ')[0];
  var initial = string.IsNullOrWhiteSpace(who) ? "U" : who.Substring(0, 1).ToUpper();
  var role = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Farmer") ? "Farmer" : "Buyer";
  var ctl = (string)ViewContext.RouteData.Values["controller"];
  string A(params string[] c) => c.Contains(ctl) ? "active" : "";
  var banner = ctl != "Home" && ctl != "Account" && ctl != "Market";
  var title = ctl == "Dashboard" ? "Welcome back, " + first : (string)ViewData["Title"];
  var emoji = ctl switch { "Orders" => "📦", "Price" => "📈", "Earnings" => "💰", "Listings" => "🧺", "Admin" => "🛡️", "Logistics" => "🚚", "Dashboard" => "🌾", _ => "🌿" };
  var sub = ctl switch
  {
    "Orders" => "Track every order and its transport.",
    "Price" => "Market prices with source, date and unit.",
    "Earnings" => "Completed sales, recorded costs and net proceeds.",
    "Listings" => "Manage your produce and live stock.",
    "Admin" => "Users, listings, orders and system health at a glance.",
    "Logistics" => "Transport bookings, partners and background events.",
    "Dashboard" => "Here is what is happening on your farm marketplace today.",
    _ => "Fresh from the farm, fair for everyone."
  };
  var tw = (title ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · FarmConnect</title>
  <script>try{var t=localStorage.getItem('fc-theme')||'light';document.documentElement.dataset.theme=t;document.documentElement.dataset.bsTheme=t}catch(e){}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="@(banner ? "hasb" : "")">
<div class="scrollbar" aria-hidden="true"></div>
<nav class="fc-nav navbar navbar-expand-lg sticky-top" aria-label="Main">
  <div class="container">
    <a class="brand" asp-controller="Home" asp-action="Index" aria-label="FarmConnect home">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 20c0-9 5-15 15-16 0 9-5 15-14 15"/><path d="M5 20c3-5 6-8 10-10"/></svg>
      <span><b>FARMCONNECT</b><small>FROM OUR FARMS TO YOUR HOME</small></span>
    </a>
    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nv" aria-label="Toggle menu"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nv">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item"><a class="nav-link @A("Market")" asp-controller="Market" asp-action="Index">Marketplace</a></li>
        @if (auth) { <li class="nav-item"><a class="nav-link @A("Price")" asp-controller="Price" asp-action="Index">Price History</a></li> }
        @if (User.IsInRole("Farmer"))
        {
          <li class="nav-item"><a class="nav-link @A("Listings")" asp-controller="Listings" asp-action="Index">My Listings</a></li>
          <li class="nav-item"><a class="nav-link @A("Orders")" asp-controller="Orders" asp-action="Index">Orders Received</a></li>
          <li class="nav-item"><a class="nav-link @A("Earnings")" asp-controller="Earnings" asp-action="Index">Earnings</a></li>
        }
        @if (User.IsInRole("Buyer")) { <li class="nav-item"><a class="nav-link @A("Orders")" asp-controller="Orders" asp-action="Index">My Orders</a></li> }
        @if (User.IsInRole("Admin"))
        {
          <li class="nav-item"><a class="nav-link @A("Admin")" asp-controller="Admin" asp-action="Index">Admin</a></li>
          <li class="nav-item"><a class="nav-link @A("Logistics")" asp-controller="Logistics" asp-action="Index">Logistics</a></li>
        }
        <li class="nav-ind" aria-hidden="true"></li>
      </ul>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <button id="themeBtn" class="theme-btn" type="button" aria-label="Switch theme">🌙</button>
        @if (auth)
        {
          <div class="dropdown">
            <button class="avatar" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">@initial</button>
            <ul class="dropdown-menu dropdown-menu-end fc-dd">
              <li class="dd-h"><b>@who</b><small>@role</small></li>
              <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">🏠 Dashboard</a></li>
              <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item">🚪 Logout</button></form></li>
            </ul>
          </div>
        }
        else
        {
          <a class="btn-fc-ghost" asp-controller="Account" asp-action="Login">Login</a>
          <a class="btn-fc" asp-controller="Account" asp-action="Register">Get started</a>
        }
      </div>
    </div>
  </div>
</nav>
<div class="toasts" role="status" aria-live="polite">
  @if (TempData["Ok"] != null) { <div class="toast-fc">✅ <span>@TempData["Ok"]</span><button aria-label="Dismiss">×</button></div> }
  @if (TempData["Error"] != null) { <div class="toast-fc bad">⚠️ <span>@TempData["Error"]</span><button aria-label="Dismiss">×</button></div> }
</div>

@if (banner)
{
  <div class="container pt-3">
    <section class="pagebanner" data-px aria-label="@title">
      <div class="sky" aria-hidden="true">
        <div class="sun"><i></i></div>
        <div class="cloud" style="--t:12%;--w:130px;--s:60s;--dl:-20s"></div>
        <div class="cloud" style="--t:34%;--w:90px;--s:84s;--dl:-55s"></div>
        <svg class="bird" viewBox="0 0 40 16" style="--t:22%;--s:30s;--dl:-8s;width:26px"><path d="M2 12 Q11 0 20 10 Q29 0 38 12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        <svg class="hill h1" viewBox="0 0 1440 320" preserveAspectRatio="none"><path d="M0 170 C240 70 480 230 720 150 S1200 50 1440 140 V320 H0Z"/></svg>
        <svg class="hill h2" viewBox="0 0 1440 320" preserveAspectRatio="none"><path d="M0 120 C200 200 460 60 740 130 S1230 210 1440 110 V320 H0Z"/></svg>
        <svg class="hill h3" viewBox="0 0 1440 320" preserveAspectRatio="none"><path d="M0 110 C260 40 520 190 800 120 S1200 40 1440 100 V320 H0Z"/></svg>
      </div>
      <div class="glow"></div>
      <div class="pb-in">
        <span class="pb-emoji" aria-hidden="true">@emoji</span>
        <div>
          <span class="eyebrow">FARMCONNECT</span>
          <h1 class="words">@for (var i = 0; i < tw.Length; i++) { <span style="--w:@i">@tw[i]</span> }</h1>
          <p class="lead-fc pb-sub">@sub</p>
        </div>
      </div>
    </section>
  </div>
}

<main class="container py-4">@RenderBody()</main>

<footer class="site-foot">
  <svg class="wave" viewBox="0 0 2880 120" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 C240 0 480 120 720 60 S1200 0 1440 60 C1680 0 1920 120 2160 60 S2640 0 2880 60 V0 H0Z"/></svg>
  <div class="container foot-in">
    <div class="fcol brandcol">
      <div class="fbrand"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#E7A642" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 20c0-9 5-15 15-16 0 9-5 15-14 15"/><path d="M5 20c3-5 6-8 10-10"/></svg><b>FarmConnect</b></div>
      <p>Farmers and buyers, connected directly. Fresh produce, fair prices and honest data.</p>
    </div>
    <div class="fcol"><h4>Explore</h4>
      <a asp-controller="Market" asp-action="Index">Marketplace</a>
      <a asp-controller="Price" asp-action="Index">Price History</a>
      @if (!auth) { <a asp-controller="Account" asp-action="Login">Login</a><a asp-controller="Account" asp-action="Register">Create account</a> }
    </div>
    <div class="fcol"><h4>For you</h4>
      @if (User.IsInRole("Farmer")) { <a asp-controller="Listings" asp-action="Index">My Listings</a><a asp-controller="Orders" asp-action="Index">Orders Received</a><a asp-controller="Earnings" asp-action="Index">Earnings</a> }
      else if (User.IsInRole("Buyer")) { <a asp-controller="Orders" asp-action="Index">My Orders</a><a asp-controller="Dashboard" asp-action="Index">Dashboard</a> }
      else if (User.IsInRole("Admin")) { <a asp-controller="Admin" asp-action="Index">Admin</a><a asp-controller="Logistics" asp-action="Index">Logistics</a> }
      else { <a asp-controller="Account" asp-action="Register" asp-route-role="Farmer">Sell your harvest</a><a asp-controller="Account" asp-action="Register">Start buying</a> }
    </div>
    <div class="fcol"><h4>Good to know</h4>
      <span>Sample price data is always labelled.</span>
      <span>Transport bookings use demo partners.</span>
      <span>No online payments yet.</span>
    </div>
  </div>
  <div class="foot-crops" aria-hidden="true"><span>🌱</span><span>🌾</span><span>🌽</span><span>🥬</span><span>🍅</span><span>🌾</span><span>🥕</span><span>🌱</span><span>🌽</span><span>🌾</span><span>🍆</span><span>🌱</span><em>🚜</em></div>
  <div class="container foot-bar"><span>© @DateTime.Now.Year FarmConnect</span><span>BUILT WITH PURPOSE. DELIVERED WITH CARE. 🌾</span><button type="button" class="foot-top" data-top>Back to top ↑</button></div>
</footer>
<button class="totop" id="toTop" type="button" aria-label="Back to top">↑</button>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>setTimeout(function(){ if(!window.__fc){ document.querySelectorAll('.reveal').forEach(function(e){ e.classList.add('in'); }); } }, 1500);</script>
<script src="~/js/ui.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>