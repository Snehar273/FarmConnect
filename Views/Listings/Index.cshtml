@model List<Listing>
@{ ViewData["Title"] = "My Listings"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><h1 class="page-h">My Listings</h1><a class="btn-fc" asp-action="Create">+ ADD PRODUCE</a></div>
<div class="table-wrap reveal"><table class="fc-table">
  <thead><tr><th>Produce</th><th>Grade</th><th>Available</th><th>Sold</th><th>Min order</th><th>Price</th><th>Status</th><th></th></tr></thead>
  <tbody>
  @foreach (var l in Model)
  {
    <tr>
      <td><span class="mini">@l.Produce.Emoji</span> <b>@l.Produce.Name</b> <small class="text-muted">@l.Variety · @l.Location</small></td>
      <td>@l.Grade</td><td>@l.QuantityAvailable.ToString("0.##") @l.Unit</td><td>@l.QuantitySold.ToString("0.##") @l.Unit</td>
      <td>@l.MinOrderQty.ToString("0.##") @l.Unit</td><td>₹@l.PricePerUnit.ToString("0.##")/@l.Unit</td>
      <td><span class="st st-@l.Status">@l.Status</span></td>
      <td class="text-nowrap">
        <a class="btn-sm-fc" asp-action="Edit" asp-route-id="@l.Id">Edit</a>
        <form asp-action="Toggle" asp-route-id="@l.Id" method="post" class="d-inline"><button class="btn-sm-fc">@(l.Status == ListingStatus.Active ? "Deactivate" : "Activate")</button></form>
        <form asp-action="Remove" asp-route-id="@l.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this listing?')"><button class="btn-sm-fc danger">Remove</button></form>
      </td>
    </tr>
  }
  @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No listings yet. Add your first produce!</td></tr> }
  </tbody></table></div>
