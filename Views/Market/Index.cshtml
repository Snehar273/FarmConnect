@model List<Listing>
@functions {
  static string Qs(IQueryCollection q, string set, string val)
  {
    var l = q.Where(x => x.Key != set && !string.IsNullOrEmpty(x.Value)).Select(x => x.Key + "=" + Uri.EscapeDataString(x.Value.ToString())).ToList();
    if (val != null) l.Add(set + "=" + Uri.EscapeDataString(val));
    return "?" + string.Join("&", l);
  }
}
@{
  ViewData["Title"] = "Marketplace"; var r = Context.Request.Query;
  var labels = new Dictionary<string, string> { ["q"] = "Search", ["grade"] = "Grade", ["location"] = "Location", ["minPrice"] = "Min ₹", ["maxPrice"] = "Max ₹", ["sort"] = "Sort" };
  var produceList = (List<Produce>)ViewBag.ProduceList; var hasPulse = ViewBag.PulseJson != null && ViewBag.PulseLast != null;
}
<link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />

<section class="scene mkt" data-px>
  <partial name="_SceneBg" />
  <div class="glow"></div>
  <div class="content">
    <span class="eyebrow">LIVING FARM MARKETPLACE</span>
    <h1 class="words"><span style="--w:0">Fresh</span> <span style="--w:1">produce,</span> <span style="--w:2"><em>straight</em></span> <span style="--w:3"><em>from</em></span> <span style="--w:4">the</span> <span style="--w:5">source.</span></h1>
    <p class="lead-fc">Search, filter and tap <b>+</b> on any card to choose your quantity. Stock and prices are always live.</p>
    <form id="filters" method="get" class="mfilter glass" role="search">
      <div class="mf-search"><span aria-hidden="true">🔍</span><input name="q" value="@r["q"]" placeholder="Search tomato, onion, banana…" aria-label="Search produce" /></div>
      <select name="grade" class="form-select" aria-label="Grade"><option value="">Any grade</option>@foreach (var g in new[] { "A", "B", "C" }) { <option value="@g" selected="@(r["grade"] == g)">Grade @g</option> }</select>
      <input name="location" value="@r["location"]" class="form-control" placeholder="📍 Location" aria-label="Location" />
      <input name="minPrice" value="@r["minPrice"]" type="number" step="any" class="form-control" placeholder="Min ₹" aria-label="Minimum price" />
      <input name="maxPrice" value="@r["maxPrice"]" type="number" step="any" class="form-control" placeholder="Max ₹" aria-label="Maximum price" />
      <select name="sort" class="form-select" aria-label="Sort"><option value="">Newest</option><option value="low" selected="@(r["sort"] == "low")">Price: low → high</option><option value="high" selected="@(r["sort"] == "high")">Price: high → low</option></select>
      <button class="btn-fc shine">SEARCH</button>
    </form>
    <div class="qchips" aria-label="Quick filters">
      <a class="qchip @(string.IsNullOrEmpty(r["q"]) ? "on" : "")" data-swap href="@Qs(r, "q", null)">✨ All</a>
      @foreach (var p in produceList.Take(8)) { <a class="qchip @(r["q"] == p.Name ? "on" : "")" data-swap href="@Qs(r, "q", p.Name)">@p.Emoji @p.Name</a> }
    </div>
  </div>
</section>

<div id="swap" class="mk-body">
  <div class="chips" aria-label="Active filters">
    @foreach (var kv in labels.Where(k => !string.IsNullOrEmpty(r[k.Key])))
    {
      <a class="chip" data-swap href="@Qs(r, kv.Key, null)" aria-label="Remove filter @kv.Value">@kv.Value: @(kv.Key == "sort" ? (r[kv.Key] == "low" ? "Low → High" : "High → Low") : r[kv.Key].ToString()) <b>×</b></a>
    }
  </div>
  <p class="count" aria-live="polite"><b>@Model.Count</b> fresh @(Model.Count == 1 ? "listing" : "listings") found</p>
  <div class="grid">
    @foreach (var l in Model) { <partial name="_ListingCard" model="l" /> }
  </div>
  @if (!Model.Any()) { <div class="emptyx reveal"><span>🥕</span><h3>Nothing matches yet</h3><p>Try removing a filter chip above or searching for something else.</p></div> }

  <h2 class="sec h2x reveal">Market Pulse</h2>
  <div class="panel pulse2 reveal">
    <div class="pulse-top">
      <div class="chips m-0">
        @foreach (var p in produceList.Take(8)) { <a class="chip" style="@(p.ProduceId == (int?)ViewBag.PulseId ? "background:var(--p);color:var(--on-p)" : "")" data-swap href="@Qs(r, "pulse", p.ProduceId.ToString())">@p.Emoji @p.Name</a> }
      </div>
      @if (hasPulse && (bool)ViewBag.PulseSample) { <span class="pill-sample">SAMPLE DATA — not live prices</span> }
    </div>
    @if (hasPulse)
    {
      var d = (decimal)ViewBag.PulseDelta;
      <p class="mt-3 mb-1"><b class="serif fs-2">₹@(((decimal)ViewBag.PulseLatest).ToString("0.##"))</b> <span class="text-muted">/ @ViewBag.PulseUnit modal · @ViewBag.PulseName</span>
        <span class="st @(d >= 0 ? "st-Accepted" : "st-Rejected")">@(d >= 0 ? "▲" : "▼") ₹@(Math.Abs(d).ToString("0.##")) vs previous day</span></p>
      <div class="chart-box"><canvas id="pulseChart" aria-label="Price trend chart for @ViewBag.PulseName" role="img"></canvas></div>
      <p class="small text-muted mt-2">Source: @ViewBag.PulseSource · Latest record: @ViewBag.PulseLast · Unit: ₹ per @ViewBag.PulseUnit</p>
      <script type="application/json" id="pulseData">@Html.Raw((string)ViewBag.PulseJson)</script>
    }
    else { <p class="text-muted mt-3 mb-0">No price history is available for this produce yet.</p> }
  </div>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script>
    window.fcRender = function () {
      var el = document.getElementById('pulseData'), cv = document.getElementById('pulseChart'); if (!el || !cv) return;
      var d = JSON.parse(el.textContent);
      fcLine(cv, d.labels, [{ label: 'Modal price (₹)', data: d.data }], '₹ per unit');
    };
    window.fcRender();
  </script>
}