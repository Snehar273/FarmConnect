@model LoginVm
@inject IWebHostEnvironment Env
@{ ViewData["Title"] = "Login"; }
<section class="scene authscene" data-px>
  <partial name="_SceneBg" />
  <div class="glow"></div>
  <div class="content">
    <div class="auth-copy">
      <span class="eyebrow">WELCOME BACK</span>
      <h1 class="words"><span style="--w:0">Back</span> <span style="--w:1">to</span> <span style="--w:2">the</span> <span style="--w:3"><em>farm.</em></span></h1>
      <p class="lead-fc">Log in to manage listings and stock, track orders and their transport, and watch fair market prices.</p>
      <ul class="perks">
        <li style="animation-delay:.9s"><span class="pi">🧺</span>Manage listings and live stock</li>
        <li style="animation-delay:1.1s"><span class="pi" style="animation-delay:-1s">📦</span>Track every order and its transport</li>
        <li style="animation-delay:1.3s"><span class="pi" style="animation-delay:-2s">📈</span>See fast, cached market prices</li>
      </ul>
    </div>
    <form class="auth-form glass" method="post" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" data-progress>
      <h2 class="fx" style="--i:0">Login</h2>
      <div class="formprog fx" style="--i:1" aria-hidden="true"><i></i></div>
      <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
      <div class="fx" style="--i:2"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username" /><span asp-validation-for="Email" class="text-danger small"></span></div>
      <div class="fx mt-3" style="--i:3"><label asp-for="Password"></label>
        <div class="pw"><input asp-for="Password" class="form-control" autocomplete="current-password" /><button type="button" data-pw aria-label="Show or hide password">👁️</button></div>
        <span asp-validation-for="Password" class="text-danger small"></span></div>
      <div class="form-check mt-3 fx" style="--i:4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Remember me</label></div>
      <button class="btn-fc shine w-100 mt-4 fx" style="--i:5">LOGIN</button>
      @if (Env.IsDevelopment())
      {
        <div class="demo fx" style="--i:6"><small>Dev quick-fill:</small>
          <button type="button" class="chip" data-fill="farmer@demo.com|Demo@12345">🧑‍🌾 Farmer</button>
          <button type="button" class="chip" data-fill="buyer@demo.com|Demo@12345">🛒 Buyer</button>
          <button type="button" class="chip" data-fill="admin@farmconnect.com|Admin@12345">🛡️ Admin</button></div>
      }
      <p class="mt-3 small text-center fx" style="--i:7">New here? <a asp-action="Register">Create an account</a></p>
    </form>
  </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }