@model LoginVm
@{ ViewData["Title"] = "Login"; }
<div class="auth reveal">
  <div class="auth-side"><h2>Welcome back to the farm.</h2><p>Log in to manage listings, place orders and track earnings.</p><div class="big">🌾</div></div>
  <form class="auth-form" method="post" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">
    <h2>Login</h2>
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username" /><span asp-validation-for="Email" class="text-danger small"></span>
    <label asp-for="Password" class="mt-3"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger small"></span>
    <div class="form-check mt-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Remember me</label></div>
    <button class="btn-fc w-100 mt-4">LOGIN</button>
    <p class="mt-3 small text-center">New here? <a asp-action="Register">Create an account</a></p>
  </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
